{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoulBind",
  "version": "0.1.0",
  "identifier": "app.soulbind.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SoulBind",
        "width": 1120,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
